rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users: Anyone can read profiles (for search), Owner can write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Tasks: Relaxed Read, Shared Write/Delete
    match /tasks/{taskId} {
      // Allow any authenticated user to read tasks (Client filters privacy)
      allow read: if request.auth != null;
      
      // Update/Delete Rule:
      // 1. Owner can update/delete
      // 2. Tagged users (Participants) can also update/delete (Shared control)
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (resource.data.visibility == 'protected' && request.auth.uid in resource.data.taggedUsers)
      );
      
      // Create Rule:
      // 1. Owner can create for themselves
      // 2. Friend can create for others IF they tag themselves (Shared Task)
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        (request.resource.data.visibility == 'protected' && request.auth.uid in request.resource.data.taggedUsers)
      );
    }

    // Goals: Relaxed Read, Strict Write
    match /goals/{goalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Comments: Everyone can read, Author can write
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.fromUserId == request.auth.uid;
    }

    // Notifications: Recipient can read/update (mark read)
    match /notifications/{notiId} {
      allow read, update: if request.auth != null && resource.data.toUserId == request.auth.uid;
      allow create: if request.auth != null; // Anyone can send noti
    }
  }
}